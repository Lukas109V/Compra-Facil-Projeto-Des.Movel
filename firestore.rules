rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/imcRecords/{recordId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validRecord() {
        let data = request.resource.data;
        return data.keys().hasAll(['weight', 'height', 'value', 'calculatedAt'])
          && data.keys().hasOnly(['weight', 'height', 'value', 'calculatedAt'])
          && data.weight is number && data.weight > 0 && data.weight <= 1000
          && data.height is number && data.height > 0 && data.height <= 3
          && data.value is number && data.value > 0
          && data.value >= data.weight / (data.height * data.height) - 0.0051
          && data.value <= data.weight / (data.height * data.height) + 0.0051
          && data.calculatedAt == request.time;
      }
      allow read, delete: if owner();
      allow create: if owner() && validRecord();
      // Permite repetir uma gravação cuja resposta se perdeu, sem criar duplicatas.
      allow update: if owner() && validRecord()
        && request.resource.data.weight == resource.data.weight
        && request.resource.data.height == resource.data.height
        && request.resource.data.value == resource.data.value;
    }
  }
}
